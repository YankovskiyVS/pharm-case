# Local stand; Google Gmail is the only email provider.
APP_PORT=8080
PUBLIC_URL=http://localhost:8080
SEED_DEMO=true
COOKIE_SECURE=false
# Leave disabled until a sender exists and Google OAuth is completed.
EMAIL_ENABLED=false
GMAIL_FROM=
OPS_EMAIL=
# Presentation PoC. Synthetic model fixture, never a medical prediction.
VOICEFM_MODE=mock
VOICEFM_WITH_MODEL=false
VOICEFM_MEMORY_LIMIT=1g
# Real mode requires verified upstream weights and trained probes; see docs/clinical-audio.md.
# OAuth secrets: .local/gmail/credentials.json (never put tokens here).
# See docs/email.md and make gmail-connect.
# Isolated HTTPS/no-seed stand: make pilot-up (port 8443).

# Patient support agent: deterministic demo planner; OpenAI tool calling needs your project key.
SUPPORT_CHAT_MODE=demo
SUPPORT_CHAT_URL=https://api.openai.com/v1
SUPPORT_CHAT_MODEL=gpt-5-mini
CLINICAL_RESEARCH_URL=https://api.openai.com/v1
CLINICAL_RESEARCH_MODEL=gpt-6-astra
CLINICAL_RESEARCH_MODE=demo
# Key file: .local/support_chat_api_key (never put its value here).
# See docs/support-chat.md for enabling OpenAI and replacing the provider.
